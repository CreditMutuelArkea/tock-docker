<?xml version="1.0" encoding="UTF-8"?>
<!--
  Tock — logback.xml pour Google Cloud Logging (GKE).

  ⚠ PRÉREQUIS OBLIGATOIRE : ce fichier n'est PAS lu tant que la variable
    d'environnement suivante n'est pas posée sur le conteneur :

        tock_logback_enabled = false

    Tock enregistre son propre ch.qos.logback.classic.spi.Configurator
    (ai.tock.shared.LogbackConfigurator, déclaré dans le SPI de tock-shared).
    Logback 1.3+ exécute les Configurator du ServiceLoader AVANT le
    DefaultJoranConfigurator, seul à lire -Dlogback.configurationFile.
    Celui de Tock renvoie DO_NOT_INVOKE_NEXT_IF_ANY : la chaîne s'arrête là et
    le XML n'est jamais chargé. `tock_logback_enabled=false` le fait renvoyer
    INVOKE_NEXT_IF_ANY et rend la main à ce fichier.

  ⚠ CONSÉQUENCE : en désactivant LogbackConfigurator, on perd aussi les
    garde-fous qu'il posait en dur (org.mongodb.driver / io.netty / okhttp3
    plafonnés à INFO, et le LevelChangePropagator pour le pont JUL).
    Ils sont restitués ci-dessous. Avec tock_default_log_level=DEBUG, les
    oublier revient à noyer les logs sous le trafic Netty et OkHttp.

  DÉPENDANCE : net.logstash.logback:logstash-logback-encoder:8.1
    (à ajouter aux <dependencies> du module tock-docker-bot-api : le
     <dependencySets> de l'assembly fabric8 la déposera dans /maven)
    ⚠ Pas la 9.0 : elle exige Jackson >= 3.0.0, Tock est en Jackson 2.22.0.

  Chargement inchangé : -Dlogback.configurationFile='file:///maven/logback.xml'
-->
<configuration>

    <!-- Rétabli : sans lui, le pont java.util.logging ne suit plus les niveaux -->
    <contextListener class="ch.qos.logback.classic.jul.LevelChangePropagator">
        <resetJUL>true</resetJUL>
    </contextListener>

    <variable name="tock_default_log_level" value="${tock_default_log_level:-warn}" />
    <variable name="tock_service_log_level" value="${tock_service_log_level:-info}" />
    <variable name="tock_database_log_level" value="${tock_database_log_level:-warn}" />

    <appender name="console" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.out</target>

        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>

                <!-- Promu en LogEntry.timestamp par l'agent GKE -->
                <timestamp>
                    <fieldName>time</fieldName>
                    <pattern>[ISO_OFFSET_DATE_TIME]</pattern>
                    <timeZone>UTC</timeZone>
                </timestamp>

                <!--
                  LE champ qui manque aujourd'hui : sans lui, l'agent ignore le
                  contenu et applique stdout -> INFO, stderr -> ERROR.
                  LogSeverity ne connaît ni WARN (c'est WARNING) ni TRACE.
                  Valides : DEBUG INFO NOTICE WARNING ERROR CRITICAL ALERT EMERGENCY
                -->
                <pattern>
                    <omitEmptyFields>true</omitEmptyFields>
                    <pattern>
                        {"severity":"%replace(%replace(%level){'WARN','WARNING'}){'TRACE','DEBUG'}"}
                    </pattern>
                </pattern>

                <message><fieldName>message</fieldName></message>
                <loggerName><fieldName>logger</fieldName></loggerName>
                <threadName><fieldName>thread</fieldName></threadName>

                <!-- UNE entrée GCP par exception, au lieu d'une par ligne de trace -->
                <stackTrace>
                    <fieldName>stack_trace</fieldName>
                    <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                        <maxDepthPerThrowable>40</maxDepthPerThrowable>
                        <maxLength>8192</maxLength>
                        <rootCauseFirst>true</rootCauseFirst>
                        <exclude>^java\.util\.concurrent\.ThreadPoolExecutor\.runWorker</exclude>
                    </throwableConverter>
                </stackTrace>

                <mdc/>

            </providers>
        </encoder>
    </appender>

    <logger name="ai.tock" level="${tock_service_log_level}" />
    <!--    <logger name="ai.tock.bot.api" level="debug" />-->
    <logger name="org.mongodb" level="${tock_database_log_level}" />

    <!--
      Rétablis depuis LogbackConfigurator.kt (l. 95-119) : ces trois loggers y
      étaient plafonnés à INFO dès que le niveau par défaut descendait à INFO
      ou en dessous. Indispensable avec tock_default_log_level=DEBUG.
    -->
    <logger name="org.mongodb.driver" level="INFO" />
    <logger name="io.netty" level="INFO" />
    <logger name="okhttp3" level="INFO" />

    <root level="${tock_default_log_level}">
        <appender-ref ref="console" />
    </root>

</configuration>